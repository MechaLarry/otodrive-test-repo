---
/**
 * About page - ported from the legacy about.html.
 *
 * Content is taken verbatim from the legacy page (who we are, the Autogas
 * credentials and the "Work Portfolio" company blurb). The legacy page has no
 * mission/vision, team or "why choose us" sections, so those are either
 * omitted or expressed strictly as the real facts already stated in the copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About Otodrive | Kenya's LPG Autogas Conversion Company"
  description="Otodrive is among the largest LPG marketers in Kenya, licensed by KEBS to convert petrol vehicles to run on LPG in partnership with Westport Fuels (Italy) and LPGTech (Poland)."
>
  <PageHero
    title="About Otodrive"
    eyebrow="Who We Are"
    subtitle={site.tagline}
    crumbs={[{ label: 'About Us', href: '/about.html' }]}
  />

  <section class="section">
    <div class="container about-lede">
      <div class="about-lede__copy">
        <h2>Who We Are</h2>
        <p>
          Otodrive is among the largest LPG marketers in Kenya. In partnership
          with global leading providers such as Westport Fuels (Italy) and
          LPGTech (Poland) of Autogas Systems, we are licensed by KEBS to
          convert gasoline-powered vehicles to run on LPG under our brand,
          OTODRIVE. Our product conforms to Energy Policy and Regulatory
          Authority, Kenya Bureau of Standards, and National Environmental
          Management Authority requirements.
        </p>
      </div>

      <figure class="about-media">
        <video class="about-media__video" controls preload="metadata" playsinline>
          <source src="/images/LPG-Service.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <figcaption class="about-media__caption">
          <img
            src="/images/play-icon.png"
            alt=""
            width="22"
            height="22"
            aria-hidden="true"
          />
          Otodrive LPG service
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Why Choose Otodrive</h2>
      <ul class="about-points">
        <li>
          <i class="fa-solid fa-certificate" aria-hidden="true"></i>
          <span>
            Licensed by KEBS to convert gasoline-powered vehicles to run on LPG
            under our brand, OTODRIVE.
          </span>
        </li>
        <li>
          <i class="fa-solid fa-handshake" aria-hidden="true"></i>
          <span>
            In partnership with global leading Autogas System providers Westport
            Fuels (Italy) and LPGTech (Poland).
          </span>
        </li>
        <li>
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <span>
            Our product conforms to Energy Policy and Regulatory Authority,
            Kenya Bureau of Standards and National Environmental Management
            Authority requirements.
          </span>
        </li>
        <li>
          <i class="fa-solid fa-gas-pump" aria-hidden="true"></i>
          <span>Among the largest LPG marketers in Kenya.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What We Do</h2>
      <p class="about-lead">
        At Otodrive, we specialize in providing eco-friendly, cost-effective
        driving solutions for every vehicle. From autogas conversions to LPG
        fueling, we've been helping drivers save money, reduce emissions, and
        drive smarter.
      </p>
      <p class="about-lead">
        Our expert team ensures premium-quality installations, backed by safety
        and reliability, using top-tier conversion kits and technology. We're
        open 24/7 to cater to the needs of our customers and make every journey
        smoother, greener, and more affordable.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .about-lede {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .about-lede__copy p {
    max-width: 60ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .about-media {
    margin: 0;
  }

  .about-media__video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about-media__caption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .about-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .about-points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .about-points i {
    flex: none;
    margin-top: 0.25rem;
    color: var(--brand-hover);
    font-size: var(--text-lg);
  }

  .about-points span {
    font-size: var(--text-sm);
  }

  .about-lead {
    max-width: 70ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .about-lead + .about-lead {
    margin-top: var(--space-4);
  }

  @media (max-width: 820px) {
    .about-lede {
      grid-template-columns: 1fr;
    }
  }
</style>
