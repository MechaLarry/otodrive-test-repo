---
/**
 * Static 404 page. Astro emits this as /404.html.
 * cPanel serves it automatically if an ErrorDocument directive is set.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../data/site';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for could not be found. Browse our LPG autogas conversion services, branches and contact details."
  noindex={true}
>
  <section class="notfound">
    <div class="container">
      <p class="notfound__code">404</p>
      <h1>We couldn't find that page</h1>
      <p class="notfound__text">
        The link may be broken or the page may have moved. Here are the most
        useful places to go next.
      </p>
      <p>
        <a class="btn btn--primary" href="/">Back to Home</a>
      </p>
      <ul class="notfound__links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-11);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1;
    color: var(--brand);
  }

  .notfound h1 {
    margin-top: var(--space-4);
  }

  .notfound__text {
    max-width: 48ch;
    margin: var(--space-5) auto var(--space-7);
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    font-size: var(--text-sm);
  }
</style>
