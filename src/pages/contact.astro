---
/**
 * Contact Us
 *
 * Ported from the legacy `contact.html`. The legacy form posted to a
 * `send_email.php` file that never existed in the repo, so that action was
 * broken. It is rebuilt here with the same real fields and wired to the
 * EmailJS account already used by the site (legacy contactscript.js).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, branches, maps } from '../data/site';
---

<BaseLayout
  title="Contact Us | OTODRIVE Kenya - LPG Autogas Conversion"
  description="Talk to Otodrive about LPG autogas conversion, servicing and refuelling in Kenya. Call, email or send us a message and our team will get back to you shortly."
>
  <PageHero
    title="Contact Us"
    subtitle="Questions about an LPG autogas conversion, a booking or a quote? Reach the Otodrive team by phone, email or the form below."
    crumbs={[{ label: 'Contact Us', href: '/contact.html' }]}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form-col">
        <h2>Send us a message</h2>

        <div class="form-alert form-alert--success" id="contactSuccess" role="status" aria-live="polite" hidden>
          Thank you for your message! We will get back to you shortly.
        </div>
        <div class="form-alert form-alert--error" id="contactError" role="alert" aria-live="assertive" hidden>
          <span id="contactErrorText">Sorry, your message could not be sent. Please try again.</span>
          <span> You can also call us on <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.</span>
        </div>

        <form id="contactForm" class="contact-form" novalidate>
          <div class="field">
            <label for="fullName">Name</label>
            <input id="fullName" name="from_name" type="text" autocomplete="name" placeholder="e.g. Jane Wanjiru" required />
            <p class="field-error" data-error-for="fullName" hidden></p>
          </div>

          <div class="field">
            <label for="number">Phone Number</label>
            <input id="number" name="phone_number" type="tel" autocomplete="tel" placeholder="e.g. 0704 644 909" required />
            <p class="field-error" data-error-for="number" hidden></p>
          </div>

          <div class="field">
            <label for="email_id">Email</label>
            <input id="email_id" name="email_id" type="email" autocomplete="email" placeholder="e.g. jane@example.com" required />
            <p class="field-error" data-error-for="email_id" hidden></p>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us how we can help" required></textarea>
            <p class="field-error" data-error-for="message" hidden></p>
          </div>

          <button type="submit" class="btn btn--primary">Send</button>
        </form>
      </div>

      <div class="contact-details-col">
        <h2>Reach us directly</h2>
        <ul class="contact-details">
          <li>
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
            <span>
              <span class="contact-details__label">Phone</span>
              <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
            </span>
          </li>
          <li>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <span>
              <span class="contact-details__label">Email</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </span>
          </li>
          <li>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span>
              <span class="contact-details__label">Head office</span>
              <address>
                {site.address.street}, {site.address.locality}, {site.address.region}
              </address>
            </span>
          </li>
        </ul>

        <img
          class="contact-image"
          src="/images/canopy%202.jpg"
          alt="Otodrive LPG autogas conversion and fuelling canopy at the Mavoko service centre"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Our branches</h2>
      <ul class="branch-list">
        {
          branches.map((branch) => (
            <li class="branch-item">
              <h3>{branch.name}</h3>
              <p>
                {branch.city}, {branch.region}
              </p>
              {branch.addressNote && <p class="branch-item__note">{branch.addressNote}</p>}
              <p>
                <a href={`tel:${branch.telephone}`}>{branch.telephone}</a>
              </p>
              <div class="branch-item__actions">
                <a class="btn btn--ghost" href={maps.view(branch)} target="_blank" rel="noopener">
                  View on map
                </a>
                <a class="btn btn--ghost" href={maps.directions(branch)} target="_blank" rel="noopener">
                  Get directions
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="map-frame">
        <iframe
          src={maps.embed(branches[0])}
          title={`Map showing ${branches[0].name} location`}
          width="600"
          height="450"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          style="border:0; width:100%; height:100%;"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<!--
  TODO(emailjs): EmailJS is used here as a placeholder pending the client's
  decision on a final form provider. The service id, template id and public key
  below are the existing Otodrive credentials (see the legacy contactscript.js).
  Swap this wiring out once a provider is chosen.
-->
<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline>
  (function () {
    var EMAILJS_SERVICE_ID = 'service_u7bdgwm';
    var EMAILJS_TEMPLATE_ID = 'template_u57mj4b';
    var EMAILJS_PUBLIC_KEY = 'ycv5mFr46ekPmud1X';

    function initContactForm() {
      var form = document.getElementById('contactForm');
      if (!form) return;

      if (window.emailjs) {
        window.emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
      }

      var successBox = document.getElementById('contactSuccess');
      var errorBox = document.getElementById('contactError');
      var submitButton = form.querySelector('button[type="submit"]');

      function clearMessages() {
        successBox.hidden = true;
        errorBox.hidden = true;
        form.querySelectorAll('.field-error').forEach(function (el) {
          el.hidden = true;
          el.textContent = '';
        });
      }

      function setFieldError(name, message) {
        var el = form.querySelector('[data-error-for="' + name + '"]');
        if (el) {
          el.textContent = message;
          el.hidden = false;
        }
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        clearMessages();

        var name = document.getElementById('fullName');
        var phone = document.getElementById('number');
        var email = document.getElementById('email_id');
        var message = document.getElementById('message');

        var firstInvalid = null;
        var digits = phone.value.replace(/\D/g, '');

        if (!name.value.trim()) {
          setFieldError('fullName', 'Please enter your name.');
          firstInvalid = firstInvalid || name;
        }
        // Accept local (07...) and international (+254...) formats.
        if (digits.length < 9) {
          setFieldError('number', 'Please enter a valid phone number.');
          firstInvalid = firstInvalid || phone;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
          setFieldError('email_id', 'Please enter a valid email address.');
          firstInvalid = firstInvalid || email;
        }
        if (!message.value.trim()) {
          setFieldError('message', 'Please enter a message.');
          firstInvalid = firstInvalid || message;
        }

        if (firstInvalid) {
          errorText.textContent = 'Please correct the highlighted fields and try again.';
          errorBox.hidden = false;
          firstInvalid.focus();
          return;
        }

        if (!window.emailjs) {
          errorText.textContent = 'Sorry, your message could not be sent right now. Please try again later.';
          errorBox.hidden = false;
          return;
        }

        var params = {
          from_name: name.value.trim(),
          phone_number: phone.value.trim(),
          email_id: email.value.trim(),
          message: message.value.trim(),
        };

        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';

        window.emailjs
          .send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, params)
          .then(function () {
            successBox.hidden = false;
            form.reset();
          })
          .catch(function (error) {
            console.error('Failed to send email:', error);
            errorBox.hidden = false;
          })
          .finally(function () {
            submitButton.disabled = false;
            submitButton.textContent = 'Send';
          });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .contact-form-col h2,
  .contact-details-col h2 {
    margin-bottom: var(--space-5);
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    transition: border-color var(--ease), box-shadow var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
    outline: none;
  }

  .field-error {
    color: var(--danger);
    font-size: var(--text-xs);
  }

  .form-alert {
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .form-alert--success {
    background: var(--brand-soft);
    border-color: var(--success);
    color: var(--ink-2);
  }

  .form-alert--error {
    background: #fdeceb;
    border-color: var(--danger);
    color: var(--ink-2);
  }

  .contact-details {
    display: grid;
    gap: var(--space-5);
  }

  .contact-details li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .contact-details li i {
    margin-top: 3px;
    color: var(--brand-hover);
    font-size: var(--text-lg);
  }

  .contact-details__label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact-details address {
    font-style: normal;
    color: var(--body);
  }

  .contact-image {
    width: 100%;
    margin-top: var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .branch-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .branch-item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .branch-item h3 {
    font-size: var(--text-lg);
  }

  .branch-item__note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .branch-item__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .map-frame {
    height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
