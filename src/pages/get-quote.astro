---
/**
 * Get a Free Quote
 *
 * Ported from the legacy `get-quote.html`. The legacy page was mistakenly
 * titled "Contact" (the same title as contact.html); this page sets its own
 * distinct SEO title. The form keeps the same fields and EmailJS wiring as the
 * legacy implementation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Get a Free Quote | OTODRIVE Kenya - LPG Autogas Conversion"
  description="Request a free, no-obligation LPG autogas conversion quote from Otodrive Kenya. Tell us about your vehicle and our team will get back to you shortly."
>
  <PageHero
    title="Get a Free Quote"
    subtitle="Tell us about your vehicle and what you need. We will review your details and come back to you with a free, no-obligation quote."
    crumbs={[{ label: 'Get a Free Quote', href: '/get-quote.html' }]}
  />

  <section class="section">
    <div class="container quote-grid">
      <div class="quote-form-col">
        <h2>Request your quote</h2>

        <div class="form-alert form-alert--success" id="quoteSuccess" role="status" aria-live="polite" hidden>
          Thank you! Your request has been sent and we will get back to you shortly.
        </div>
        <div class="form-alert form-alert--error" id="quoteError" role="alert" aria-live="assertive" hidden>
          <span id="quoteErrorText">Sorry, your request could not be sent. Please try again.</span>
          <span> You can also call us on <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.</span>
        </div>

        <form id="contactForm" class="quote-form" novalidate>
          <div class="field">
            <label for="fullName">Name</label>
            <input id="fullName" name="from_name" type="text" autocomplete="name" placeholder="e.g. Jane Wanjiru" required />
            <p class="field-error" data-error-for="fullName" hidden></p>
          </div>

          <div class="field">
            <label for="number">Phone Number</label>
            <input id="number" name="phone_number" type="tel" autocomplete="tel" placeholder="e.g. 0704 644 909" required />
            <p class="field-error" data-error-for="number" hidden></p>
          </div>

          <div class="field">
            <label for="email_id">Email</label>
            <input id="email_id" name="email_id" type="email" autocomplete="email" placeholder="e.g. jane@example.com" required />
            <p class="field-error" data-error-for="email_id" hidden></p>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your vehicle and the service you are interested in" required></textarea>
            <p class="field-error" data-error-for="message" hidden></p>
          </div>

          <button type="submit" class="btn btn--primary">Send</button>
        </form>
      </div>

      <aside class="quote-next">
        <h2>What happens next</h2>
        <ol class="quote-next__steps">
          <li>
            <span class="quote-next__num">1</span>
            <div>
              <h3>You send your details</h3>
              <p>Tell us about your vehicle and the service you are interested in.</p>
            </div>
          </li>
          <li>
            <span class="quote-next__num">2</span>
            <div>
              <h3>We review your request</h3>
              <p>Our team looks at your details and prepares your quote.</p>
            </div>
          </li>
          <li>
            <span class="quote-next__num">3</span>
            <div>
              <h3>We get back to you</h3>
              <p>We contact you to discuss the quote and, if you wish, arrange a visit.</p>
            </div>
          </li>
        </ol>
        <p class="quote-next__note">
          Prefer to talk it through? Call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<!--
  TODO(emailjs): EmailJS is used here as a placeholder pending the client's
  decision on a final form provider. The service id, template id and public key
  below are the existing Otodrive credentials (see the legacy contactscript.js).
  Swap this wiring out once a provider is chosen.
-->
<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline>
  (function () {
    var EMAILJS_SERVICE_ID = 'service_u7bdgwm';
    var EMAILJS_TEMPLATE_ID = 'template_u57mj4b';
    var EMAILJS_PUBLIC_KEY = 'ycv5mFr46ekPmud1X';

    function initQuoteForm() {
      var form = document.getElementById('contactForm');
      if (!form) return;

      if (window.emailjs) {
        window.emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
      }

      var successBox = document.getElementById('quoteSuccess');
      var errorBox = document.getElementById('quoteError');
      var submitButton = form.querySelector('button[type="submit"]');

      function clearMessages() {
        successBox.hidden = true;
        errorBox.hidden = true;
        form.querySelectorAll('.field-error').forEach(function (el) {
          el.hidden = true;
          el.textContent = '';
        });
      }

      function setFieldError(name, message) {
        var el = form.querySelector('[data-error-for="' + name + '"]');
        if (el) {
          el.textContent = message;
          el.hidden = false;
        }
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        clearMessages();

        var name = document.getElementById('fullName');
        var phone = document.getElementById('number');
        var email = document.getElementById('email_id');
        var message = document.getElementById('message');

        var firstInvalid = null;
        var digits = phone.value.replace(/\D/g, '');

        if (!name.value.trim()) {
          setFieldError('fullName', 'Please enter your name.');
          firstInvalid = firstInvalid || name;
        }
        // Accept local (07...) and international (+254...) formats.
        if (digits.length < 9) {
          setFieldError('number', 'Please enter a valid phone number.');
          firstInvalid = firstInvalid || phone;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
          setFieldError('email_id', 'Please enter a valid email address.');
          firstInvalid = firstInvalid || email;
        }
        if (!message.value.trim()) {
          setFieldError('message', 'Please tell us about your vehicle.');
          firstInvalid = firstInvalid || message;
        }

        if (firstInvalid) {
          errorText.textContent = 'Please correct the highlighted fields and try again.';
          errorBox.hidden = false;
          firstInvalid.focus();
          return;
        }

        if (!window.emailjs) {
          errorText.textContent = 'Sorry, your request could not be sent right now. Please try again later.';
          errorBox.hidden = false;
          return;
        }

        var params = {
          from_name: name.value.trim(),
          phone_number: phone.value.trim(),
          email_id: email.value.trim(),
          message: message.value.trim(),
        };

        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';

        window.emailjs
          .send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, params)
          .then(function () {
            successBox.hidden = false;
            form.reset();
          })
          .catch(function (error) {
            console.error('Failed to send email:', error);
            errorBox.hidden = false;
          })
          .finally(function () {
            submitButton.disabled = false;
            submitButton.textContent = 'Send';
          });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuoteForm);
    } else {
      initQuoteForm();
    }
  })();
</script>

<style>
  .quote-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .quote-form-col h2,
  .quote-next h2 {
    margin-bottom: var(--space-5);
  }

  .quote-form {
    display: grid;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    transition: border-color var(--ease), box-shadow var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
    outline: none;
  }

  .field-error {
    color: var(--danger);
    font-size: var(--text-xs);
  }

  .form-alert {
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .form-alert--success {
    background: var(--brand-soft);
    border-color: var(--success);
    color: var(--ink-2);
  }

  .form-alert--error {
    background: #fdeceb;
    border-color: var(--danger);
    color: var(--ink-2);
  }

  .quote-next {
    align-self: start;
    padding: var(--space-6);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .quote-next__steps {
    display: grid;
    gap: var(--space-5);
  }

  .quote-next__steps li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .quote-next__num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    background: var(--brand);
    color: var(--ink);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .quote-next__steps h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .quote-next__steps p {
    font-size: var(--text-sm);
  }

  .quote-next__note {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .quote-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
