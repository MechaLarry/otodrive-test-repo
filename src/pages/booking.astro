---
/**
 * Book a Service
 *
 * Ported from the legacy `booking.html` + `js/booking.js` as a single page with
 * the booking logic inlined (no dependency on js/booking.js).
 *
 * Legacy bugs fixed in the inline script:
 *   (a) `calendarLinkDiv` was referenced before it was declared.
 *   (b) a hidden `selectedTime` input was marked `required`, blocking submit;
 *       the selected time is now genuinely validated in JS.
 *   (c) dates were parsed in local time; all date logic is now done in EAT.
 *   (d) every generated slot was reported as available; availability is now
 *       honest (see the ASSUMPTION comment in the script).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Book a Service | OTODRIVE Kenya - LPG Autogas"
  description="Book an LPG autogas inspection, diagnosis, conversion, service or refuelling appointment with Otodrive Kenya. Choose a date and time and confirm your booking online."
>
  <PageHero
    title="Book a Service"
    subtitle="Choose a service, pick a date and time that suits you, and confirm your appointment online."
    crumbs={[{ label: 'Book a Service', href: '/booking.html' }]}
  />

  <section class="section">
    <div class="container booking-grid">
      <form
        id="bookingForm"
        class="booking-form"
        data-contact-phone={site.phoneDisplay}
        novalidate
      >
        <div class="form-alert form-alert--error" id="bookingAlert" role="alert" aria-live="assertive" hidden></div>
        <div class="form-alert form-alert--success" id="bookingSuccess" role="status" aria-live="polite" hidden>
          Your booking has been confirmed! A confirmation email with a calendar invite has been sent to your email
          address.
        </div>

        <fieldset class="fieldset">
          <legend>Your details</legend>
          <div class="field">
            <label for="bookingName">Full Name</label>
            <input id="bookingName" name="name" type="text" autocomplete="name" placeholder="e.g. Jane Wanjiru" required />
          </div>
          <div class="field">
            <label for="bookingPhone">Phone Number</label>
            <input id="bookingPhone" name="phone" type="tel" autocomplete="tel" placeholder="e.g. 0704 644 909" required />
          </div>
          <div class="field">
            <label for="bookingVehicle">Vehicle Details</label>
            <input id="bookingVehicle" name="vehicle" type="text" placeholder="Make, Model, Year" required />
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>Appointment</legend>
          <div class="field">
            <label for="bookingService">Service Type</label>
            <select id="bookingService" name="service" required>
              <option value="">Select a service</option>
              <option value="Vehicle Inspection">Vehicle Inspection</option>
              <option value="Autogas Diagnosis">Autogas Diagnosis</option>
              <option value="Autogas Conversion">Autogas Conversion</option>
              <option value="Autogas Service">Autogas Vehicle Service</option>
              <option value="LPG Refueling">LPG Refueling</option>
            </select>
          </div>
          <div class="field">
            <label for="bookingDate">Date</label>
            <input type="date" id="bookingDate" name="date" required />
            <p class="hint">Opening hours: Mon&ndash;Fri 08:00&ndash;17:00, Sat 08:30&ndash;13:00. Closed Sundays.</p>
          </div>
          <div class="field">
            <span class="field-label" id="slotsLegend">Available Time Slots</span>
            <div id="timeSlots" class="time-slots" role="group" aria-labelledby="slotsLegend"></div>
            <p class="hint" id="slotsHint">Select a date to see available times.</p>
            <input type="hidden" id="bookingTime" name="time" />
          </div>
        </fieldset>

        <button type="submit" id="bookingSubmit" class="btn btn--primary">Book Appointment</button>
        <div id="calendarLink" class="calendar-link" hidden></div>
      </form>

      <aside class="booking-aside">
        <h2>What to expect</h2>
        <ul class="booking-aside__list">
          <li>Choose the service you need and a time that suits you.</li>
          <li>You will receive a confirmation with a calendar invite by email.</li>
          <li>Please arrive a few minutes before your appointment time.</li>
          <li>Need to change your booking? Get in touch and we will help.</li>
        </ul>
        <p class="booking-aside__note">
          Prefer to book by phone? Call <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var API_URL = 'https://otodrive-booking-api.onrender.com';

    // Africa/Nairobi is UTC+3 all year round (no DST).
    var EAT_OFFSET_MS = 3 * 60 * 60 * 1000;
    var SLOT_MINUTES = 30;

    // Opening hours in minutes from midnight, keyed by weekday (0 = Sunday).
    // Sunday is intentionally absent: the business is closed.
    var HOURS = {
      1: { open: 8 * 60, close: 17 * 60 }, // Monday    08:00-17:00
      2: { open: 8 * 60, close: 17 * 60 }, // Tuesday   08:00-17:00
      3: { open: 8 * 60, close: 17 * 60 }, // Wednesday 08:00-17:00
      4: { open: 8 * 60, close: 17 * 60 }, // Thursday  08:00-17:00
      5: { open: 8 * 60, close: 17 * 60 }, // Friday    08:00-17:00
      6: { open: 8 * 60 + 30, close: 13 * 60 } // Saturday 08:30-13:00
    };

    function pad(n) {
      return n < 10 ? '0' + n : '' + n;
    }

    function minutesToTime(m) {
      return pad(Math.floor(m / 60)) + ':' + pad(m % 60);
    }

    // "Now" expressed as EAT wall-clock: shift the UTC epoch forward by the
    // offset, then read the UTC fields of the shifted Date.
    function nowEat() {
      return new Date(Date.now() + EAT_OFFSET_MS);
    }

    function todayEatString() {
      return nowEat().toISOString().slice(0, 10);
    }

    function nowEatMinutes() {
      var d = nowEat();
      return d.getUTCHours() * 60 + d.getUTCMinutes();
    }

    // FIX (bug c): derive the weekday from the calendar date in EAT rather than
    // `new Date(dateStr).getDay()`, which used the visitor's local timezone and
    // could shift the day by one. EAT has no DST, so the weekday of a
    // YYYY-MM-DD calendar date is identical to its UTC weekday.
    function eatWeekday(dateStr) {
      var parts = dateStr.split('-').map(Number);
      return new Date(Date.UTC(parts[0], parts[1] - 1, parts[2])).getUTCDay();
    }

    function generateSlots(dateStr) {
      if (!dateStr) return [];
      var day = eatWeekday(dateStr);
      var hours = HOURS[day];
      if (!hours) return []; // Sunday - closed.

      var today = todayEatString();
      if (dateStr < today) return []; // Past dates have no bookable slots.

      var isToday = dateStr === today;
      var nowMin = nowEatMinutes();
      var slots = [];

      for (var m = hours.open; m <= hours.close - SLOT_MINUTES; m += SLOT_MINUTES) {
        // ASSUMPTION: the booking API exposes no availability endpoint, so we
        // cannot know which slots are already taken. Every future in-hours slot
        // is therefore treated as open. For today, slots whose start time has
        // already passed in EAT are disabled so nobody books a past time.
        var available = !(isToday && m <= nowMin);
        slots.push({ time: minutesToTime(m), available: available });
      }
      return slots;
    }

    function init() {
      var form = document.getElementById('bookingForm');
      if (!form) return;

      var dateInput = document.getElementById('bookingDate');
      var timeInput = document.getElementById('bookingTime');
      var slotsContainer = document.getElementById('timeSlots');
      var slotsHint = document.getElementById('slotsHint');
      var alertBox = document.getElementById('bookingAlert');
      var successBox = document.getElementById('bookingSuccess');
      var submitButton = document.getElementById('bookingSubmit');
      // FIX (bug a): declare calendarLinkDiv up front so it is never referenced
      // before it exists.
      var calendarLinkDiv = document.getElementById('calendarLink');
      var contactPhone = form.getAttribute('data-contact-phone') || '';

      // Do not allow booking a date in the past (EAT).
      dateInput.min = todayEatString();

      function hideAlert() {
        alertBox.hidden = true;
        alertBox.textContent = '';
      }

      function showAlert(message) {
        alertBox.textContent = message;
        alertBox.hidden = false;
      }

      function renderSlots(dateStr) {
        slotsContainer.innerHTML = '';
        timeInput.value = '';

        if (!dateStr) {
          slotsHint.textContent = 'Select a date to see available times.';
          return;
        }

        var slots = generateSlots(dateStr);
        if (!slots.length) {
          slotsHint.textContent =
            eatWeekday(dateStr) === 0
              ? 'We are closed on Sundays. Please choose another day.'
              : 'No time slots are available for this date. Please choose another day.';
          return;
        }

        slotsHint.textContent = 'Select an available time below.';

        slots.forEach(function (slot) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'time-slot';
          btn.textContent = slot.time;
          btn.setAttribute('aria-pressed', 'false');

          if (slot.available) {
            btn.setAttribute('aria-label', 'Select ' + slot.time);
            btn.addEventListener('click', function () {
              selectSlot(btn, slot.time);
            });
          } else {
            btn.disabled = true;
            btn.classList.add('time-slot--unavailable');
            btn.setAttribute('aria-label', slot.time + ' (unavailable)');
          }

          slotsContainer.appendChild(btn);
        });
      }

      function selectSlot(button, time) {
        var buttons = slotsContainer.querySelectorAll('.time-slot');
        for (var i = 0; i < buttons.length; i++) {
          buttons[i].classList.remove('time-slot--selected');
          buttons[i].setAttribute('aria-pressed', 'false');
        }
        button.classList.add('time-slot--selected');
        button.setAttribute('aria-pressed', 'true');
        timeInput.value = time;
        hideAlert();
      }

      dateInput.addEventListener('change', function () {
        successBox.hidden = true;
        hideAlert();
        renderSlots(dateInput.value);
      });

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        hideAlert();
        successBox.hidden = true;
        calendarLinkDiv.hidden = true;
        calendarLinkDiv.innerHTML = '';

        var name = document.getElementById('bookingName');
        var phone = document.getElementById('bookingPhone');
        var vehicle = document.getElementById('bookingVehicle');
        var service = document.getElementById('bookingService');
        var date = dateInput.value;
        var time = timeInput.value;

        // FIX (bug b): validate the selected time explicitly here instead of via
        // a `required` hidden input, which silently blocked submission.
        var errors = [];
        var firstInvalid = null;

        if (!name.value.trim()) {
          errors.push('Please enter your full name.');
          firstInvalid = firstInvalid || name;
        }
        if (phone.value.replace(/\D/g, '').length < 9) {
          errors.push('Please enter a valid phone number.');
          firstInvalid = firstInvalid || phone;
        }
        if (!vehicle.value.trim()) {
          errors.push('Please enter your vehicle details (make, model, year).');
          firstInvalid = firstInvalid || vehicle;
        }
        if (!service.value) {
          errors.push('Please select a service.');
          firstInvalid = firstInvalid || service;
        }
        if (!date) {
          errors.push('Please choose a date.');
          firstInvalid = firstInvalid || dateInput;
        }
        if (!time) {
          errors.push('Please choose an available time slot.');
        }

        if (errors.length) {
          showAlert(errors.join(' '));
          if (firstInvalid) firstInvalid.focus();
          return;
        }

        // Re-check the chosen slot is genuinely bookable for the date.
        var isValidSlot = generateSlots(date).some(function (slot) {
          return slot.time === time && slot.available;
        });
        if (!isValidSlot) {
          showAlert('That time is no longer available for the selected date. Please choose another slot.');
          renderSlots(date);
          return;
        }

        // Keep the same request body field names so the backend keeps working.
        var data = {
          name: name.value.trim(),
          phone: phone.value.trim(),
          vehicle: vehicle.value.trim(),
          date: date,
          time: time,
          service: service.value
        };

        submitButton.disabled = true;
        submitButton.textContent = 'Booking\u2026';

        fetch(API_URL + '/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (result) {
            if (result && result.success) {
              successBox.hidden = false;
              if (result.calendarUrl) {
                var link = document.createElement('a');
                link.className = 'btn btn--dark calendar-btn';
                link.href = result.calendarUrl;
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                link.innerHTML =
                  '<i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Add to Google Calendar';
                calendarLinkDiv.appendChild(link);
                calendarLinkDiv.hidden = false;
              }
              form.reset();
              renderSlots('');
            } else {
              showAlert('Booking failed: ' + ((result && result.error) || 'unexpected server response') + '.');
            }
          })
          .catch(function (error) {
            console.error('Booking request failed:', error);
            showAlert(
              'Booking failed: the booking service could not be reached. Please try again' +
                (contactPhone ? ', or call us on ' + contactPhone : '') +
                '.'
            );
          })
          .finally(function () {
            submitButton.disabled = false;
            submitButton.textContent = 'Book Appointment';
          });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .booking-form {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .fieldset {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .fieldset + .fieldset {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .fieldset legend {
    padding: 0;
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label,
  .field-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .field input,
  .field select {
    width: 100%;
    padding: 0.75rem var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    transition: border-color var(--ease), box-shadow var(--ease);
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
    outline: none;
  }

  .hint {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .time-slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: var(--space-3);
  }

  .time-slot {
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--ease), color var(--ease), border-color var(--ease);
  }

  .time-slot:hover:not(:disabled) {
    background: var(--brand-soft);
    border-color: var(--brand);
  }

  .time-slot--selected {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--ink);
  }

  .time-slot--unavailable {
    background: var(--surface-alt);
    border-color: var(--line);
    color: var(--muted);
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .form-alert {
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .form-alert--success {
    background: var(--brand-soft);
    border-color: var(--success);
    color: var(--ink-2);
  }

  .form-alert--error {
    background: #fdeceb;
    border-color: var(--danger);
    color: var(--ink-2);
  }

  .calendar-link {
    text-align: center;
  }

  .booking-aside {
    align-self: start;
    padding: var(--space-6);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .booking-aside h2 {
    margin-bottom: var(--space-4);
  }

  .booking-aside__list {
    display: grid;
    gap: var(--space-3);
  }

  .booking-aside__list li {
    position: relative;
    padding-inline-start: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .booking-aside__list li::before {
    content: '\f058';
    position: absolute;
    inset-inline-start: 0;
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    color: var(--brand-hover);
  }

  .booking-aside__note {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  @media (min-width: 980px) {
    .booking-grid {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
</style>
