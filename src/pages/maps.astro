---
/**
 * Our Locations - rebuild of the legacy maps.html.
 *
 * Every branch is rendered from the `branches` export in src/data/site.ts so
 * the map embed, directions, viewing links, hours and phone number all stay in
 * sync. The exact street address is still pending from the client, so each
 * branch's `addressNote` is surfaced as a visible "to be confirmed" note
 * rather than inventing one.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, branches, maps } from '../data/site';
import type { Branch, OpeningHour } from '../data/site';

const dayAbbrev: Record<string, string> = {
  Monday: 'Mon',
  Tuesday: 'Tue',
  Wednesday: 'Wed',
  Thursday: 'Thu',
  Friday: 'Fri',
  Saturday: 'Sat',
  Sunday: 'Sun',
};

function formatDays(days: string[]): string {
  const abbr = days.map((day) => dayAbbrev[day] ?? day);
  if (abbr.length > 2) return `${abbr[0]}\u2013${abbr[abbr.length - 1]}`;
  return abbr.join(', ');
}

function formatTime(value: string): string {
  const [hours, minutes] = value.split(':').map(Number);
  const period = hours >= 12 ? 'pm' : 'am';
  const hour = hours % 12 === 0 ? 12 : hours % 12;
  return `${hour}:${String(minutes).padStart(2, '0')} ${period}`;
}

function formatHours(hours: OpeningHour[]): string[] {
  return hours.map((slot) => {
    if (slot.opens === '00:00' && slot.closes === '23:59') {
      return 'Open 24 hours, 7 days a week';
    }
    return `${formatDays(slot.days)}: ${formatTime(slot.opens)} \u2013 ${formatTime(slot.closes)}`;
  });
}
---

<BaseLayout
  title="Our Locations & Branches | Otodrive Kenya Autogas"
  description="Find Otodrive autogas conversion and LPG fuelling centres in Kenya: Mavoko (Nairobi) head office, Jomvu (Mombasa) and Petrocity Thika. Directions, opening hours and services for each branch."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Our Locations',
          item: `${site.url}/maps.html`,
        },
      ],
    },
  ]}
>
  <PageHero
    title="Our Locations"
    subtitle="Otodrive operates autogas conversion, LPG fuelling and vehicle service centres across Kenya. Each branch offers professional LPG autogas installation, troubleshooting, periodic servicing, repairs and refuelling. Choose your nearest centre below for directions, opening hours and the services available at that location."
    crumbs={[{ label: 'Our Locations', href: '/maps.html' }]}
  />

  <section class="section branches">
    <div class="container">
      <p class="branch-nav__label">Jump to a branch:</p>
      <ul class="branch-nav">
        {
          branches.map((branch) => (
            <li>
              <a href={`#${branch.id}`}>
                <i class="fa-solid fa-location-dot" aria-hidden="true" />
                {branch.name}
              </a>
            </li>
          ))
        }
      </ul>

      {
        branches.map((branch: Branch) => (
          <article class="branch" id={branch.id}>
            <div class="branch__map">
              <iframe
                src={maps.embed(branch)}
                title={`Map of ${branch.name}, ${branch.city}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              />
            </div>

            <div class="branch__info">
              <h2 class="branch__name">{branch.name}</h2>

              <p class="branch__place">
                <i class="fa-solid fa-location-dot" aria-hidden="true" />
                {branch.city}, {branch.region}
              </p>

              {branch.addressNote && (
                <p class="branch__address-note">
                  <i class="fa-solid fa-circle-info" aria-hidden="true" />
                  <span>
                    <strong>Address to be confirmed:</strong> {branch.addressNote}
                  </span>
                </p>
              )}

              <div class="branch__block">
                <h3 class="branch__label">Opening hours</h3>
                <ul class="branch__hours">
                  {formatHours(branch.hours).map((line) => (
                    <li>
                      <i class="fa-regular fa-clock" aria-hidden="true" />
                      {line}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="branch__block">
                <h3 class="branch__label">Services available</h3>
                <ul class="branch__services">
                  {branch.services.map((service) => (
                    <li>
                      <i class="fa-solid fa-check" aria-hidden="true" />
                      {service}
                    </li>
                  ))}
                </ul>
              </div>

              <p class="branch__phone">
                <i class="fa-solid fa-phone" aria-hidden="true" />
                <a href={`tel:${branch.telephone}`}>{site.phoneDisplay}</a>
              </p>

              <div class="branch__actions">
                <a
                  class="btn btn--primary"
                  href={maps.directions(branch)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <i class="fa-solid fa-diamond-turn-right" aria-hidden="true" />
                  Get Directions
                </a>
                <a
                  class="branch__view"
                  href={maps.view(branch)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View larger map
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .branches {
    background: var(--surface-alt);
  }

  .branch-nav__label {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--ink);
  }

  .branch-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .branch-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .branch-nav a:hover {
    background: var(--brand);
    color: var(--ink);
  }

  .branch {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    margin-top: var(--space-7);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    scroll-margin-top: var(--header-h);
  }

  .branch__map {
    flex: 1 1 420px;
    min-height: 380px;
  }

  .branch__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
  }

  .branch__info {
    display: flex;
    flex: 1 1 360px;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-7);
  }

  .branch__name {
    font-size: var(--text-2xl);
  }

  .branch__place {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--body);
  }

  .branch__place i {
    color: var(--brand);
  }

  .branch__address-note {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--brand-soft);
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .branch__address-note i {
    margin-top: 0.3em;
    color: var(--brand-hover);
  }

  .branch__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .branch__hours li,
  .branch__services li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    color: var(--body);
    font-size: var(--text-sm);
  }

  .branch__hours i {
    color: var(--brand);
  }

  .branch__services i {
    color: var(--success);
  }

  .branch__phone {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .branch__phone i {
    color: var(--brand);
  }

  .branch__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .branch__view {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .branch__info {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
