---
/**
 * Projects gallery - ported from the legacy projects.html.
 *
 * Captions and body copy are taken verbatim from the legacy page; images are
 * referenced from /images so no legacy asset is invented. A lightweight,
 * keyboard-accessible <dialog> lightbox enlarges each gallery image.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

interface Project {
  title: string;
  image: string;
  alt: string;
  body: string[];
}

const projects: Project[] = [
  {
    title: 'Toyota Passo',
    image: '/images/george2.jpg',
    alt: 'Toyota Passo compact car converted at Otodrive to run on LPG autogas',
    body: [
      'The Toyota Passo is a compact car known for its fuel efficiency and versatility. Converting it to a bi-fuel system allows the vehicle to run on two different types of fuel, typically petrol (gasoline) and liquefied petroleum gas (LPG) or compressed natural gas (CNG). This conversion process involves several key steps to ensure the car operates efficiently, safely, and in compliance with regulations.',
    ],
  },
  {
    title: 'toyota Alion',
    image: '/images/milton%20conversion%20.jpg',
    alt: 'Toyota Alion sedan fitted with a bi-fuel LPG autogas system by Otodrive',
    body: [
      'The Toyota Allion, a sedan renowned for its elegance and reliability, has been elevated to a new level of efficiency and versatility with a state-of-the-art bi-fuel system upgrade. This transformation empowers the Allion to seamlessly operate on both petrol and either liquefied petroleum gas (LPG) or compressed natural gas (CNG). The process involves precise engineering and premium-grade components to ensure top-tier performance, unmatched safety, and environmental sustainability.',
    ],
  },
  {
    title: 'Prado',
    image: '/images/pado%20conversion.jpg',
    alt: 'Toyota Prado fitted with a bi-fuel LPG autogas conversion at Otodrive',
    body: [
      'The Toyota Prado, a symbol of rugged luxury and unmatched capability, has been revolutionized with a cutting-edge bi-fuel system upgrade. This innovation enables the Prado to effortlessly switch between petrol and either liquefied petroleum gas (LPG) or compressed natural gas (CNG), offering unparalleled flexibility and efficiency. With precision engineering and top-tier components, this transformation ensures exceptional performance, enhanced safety, and a reduced environmental footprint, making the Prado a smarter, more sustainable choice for adventure enthusiasts.',
    ],
  },
  {
    title: 'Typical LPG Autogas Layout',
    image: '/images/technical%20autogas.jpg',
    alt: 'Diagram of a typical LPG autogas system layout installed in a vehicle',
    body: [
      "A typical LPG autogas layout consists of an LPG storage tank, usually installed in the boot or underneath the vehicle, connected to a fuel line that runs to the engine. The system includes a vaporizer-reducer that converts the liquid LPG into gas by heating it, using the engine's coolant system. This gas is then regulated and sent to the engine through a set of dedicated injectors. A fuel selection switch inside the cabin allows the driver to seamlessly toggle between LPG and petrol, with the entire system managed by an electronic control unit (ECU) to ensure optimal performance and safety.",
    ],
  },
  {
    title: 'Autogas Parts',
    image: '/images/technical%202%20autogas.jpg',
    alt: 'Key LPG autogas components including tank, vaporizer, injectors and ECU',
    body: [
      "A typical LPG autogas system comprises key components such as an LPG tank, fuel lines, a vaporizer-reducer, injectors, a fuel selection switch, and an electronic control unit (ECU). The tank stores LPG safely, while fuel lines deliver it to the vaporizer, where it is converted to gas. The injectors then supply the gas to the engine, with the ECU optimizing the system's performance. The fuel selection switch allows the driver to switch effortlessly between LPG and petrol as needed.",
    ],
  },
  {
    title: 'Refueling station',
    image: '/images/canopy%202.jpg',
    alt: 'Otodrive LPG autogas refuelling station forecourt under a canopy',
    body: [
      'At Otodrive, we provide a state-of-the-art LPG refueling station designed for efficiency and convenience. Our station is equipped with high-quality dispensers that ensure quick, safe, and accurate fueling every time you visit.',
      'Loyalty Program',
      'Our Loyalty Program rewards you for choosing Otodrive. Every refill gets you closer to exciting discounts, exclusive offers, and special promotions. It\u2019s our way of saying thank you for being part of the Otodrive family.',
      'Customer Service',
      'At Otodrive, customer satisfaction is our top priority. Our friendly and knowledgeable customer service team is available 24/7 to assist with any inquiries, guide you through autogas conversions, and ensure a seamless fueling experience.',
    ],
  },
];
---

<BaseLayout
  title="Our Projects | Otodrive Kenya LPG Autogas Conversions"
  description="See real Otodrive LPG autogas projects in Kenya: Toyota Passo, Allion and Prado bi-fuel conversions, typical autogas layouts, autogas parts and our LPG refuelling station."
>
  <PageHero
    title="Our Projects"
    subtitle="A look at some of the LPG autogas conversions, systems and facilities Otodrive has delivered for drivers across Kenya."
    crumbs={[{ label: 'Our Projects', href: '/projects.html' }]}
  />

  <section class="section projects">
    <div class="container">
      <h2 class="visually-hidden">Conversion projects and installations</h2>

      <ul class="project-grid">
        {
          projects.map((project) => (
            <li class="project">
              <button
                type="button"
                class="project__media"
                data-lightbox
                data-full={project.image}
                data-caption={project.title}
                aria-label={`View a larger image: ${project.title}`}
              >
                <img
                  src={project.image}
                  alt={project.alt}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </button>

              <div class="project__body">
                <h3>{project.title}</h3>
                {project.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />

  <dialog class="lightbox" id="project-lightbox" aria-label="Enlarged project image">
    <figure class="lightbox__figure">
      <img id="lightbox-image" src={projects[0].image} alt={projects[0].alt} />
      <figcaption id="lightbox-caption">{projects[0].title}</figcaption>
    </figure>
    <button type="button" class="lightbox__close" aria-label="Close enlarged image">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </dialog>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-7);
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .project__media {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-alt);
    cursor: zoom-in;
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease);
  }

  .project__media:hover img {
    transform: scale(1.04);
  }

  .project__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .project__body h3 {
    color: var(--ink);
  }

  .project__body p {
    color: var(--body);
    font-size: var(--text-sm);
  }

  /* ---- Lightbox -------------------------------------------------------- */
  .lightbox {
    position: relative;
    width: min(92vw, 1000px);
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgba(10, 10, 35, 0.85);
  }

  .lightbox__figure {
    margin: 0;
  }

  .lightbox__figure img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--dark);
  }

  .lightbox__figure figcaption {
    margin-top: var(--space-3);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    text-align: center;
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(10, 10, 35, 0.7);
    color: #fff;
    font-size: var(--text-lg);
    cursor: pointer;
    transition: background-color var(--ease);
  }

  .lightbox__close:hover {
    background: var(--brand);
    color: var(--ink);
  }
</style>

<script>
  const dialog = document.getElementById('project-lightbox') as HTMLDialogElement | null;
  const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');

  if (dialog && image) {
    const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox]');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        image.src = trigger.getAttribute('data-full') ?? '';
        image.alt = trigger.getAttribute('data-caption') ?? '';
        if (caption) caption.textContent = trigger.getAttribute('data-caption') ?? '';

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });
    });

    dialog
      .querySelector('.lightbox__close')
      ?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
