---
/**
 * Inner-page banner. Provides a consistent h1 + breadcrumb treatment so no
 * page invents its own hero, and gives search engines a clear BreadcrumbList.
 */
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
  eyebrow?: string;
}

const { title, subtitle, crumbs = [], eyebrow } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {
      eyebrow && (
        <p class="page-hero__eyebrow">{eyebrow}</p>
      )
    }
    <h1>{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}

    {
      crumbs.length > 0 && (
        <nav class="page-hero__crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((crumb, index) => (
              <li>
                {index === crumbs.length - 1 ? (
                  <span aria-current="page">{crumb.label}</span>
                ) : (
                  <a href={crumb.href}>{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: var(--space-9);
    background: var(--ink);
    color: rgba(255, 255, 255, 0.78);
    overflow: hidden;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(253, 164, 23, 0.22), transparent 70%);
    pointer-events: none;
  }

  .page-hero > .container {
    position: relative;
    z-index: 1;
  }

  .page-hero__eyebrow {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-4);
    background: rgba(253, 164, 23, 0.16);
    color: var(--brand);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .page-hero h1 {
    max-width: 22ch;
    color: #fff;
  }

  .page-hero__subtitle {
    max-width: 62ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .page-hero__crumbs {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .page-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .page-hero__crumbs li + li::before {
    content: '/';
    margin-inline-end: var(--space-2);
    color: rgba(255, 255, 255, 0.35);
  }

  .page-hero__crumbs a {
    color: rgba(255, 255, 255, 0.78);
  }

  .page-hero__crumbs a:hover {
    color: var(--brand);
  }

  .page-hero__crumbs [aria-current='page'] {
    color: var(--brand);
    font-weight: 600;
  }
</style>
