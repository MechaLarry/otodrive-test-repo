---
/**
 * Site header. Replaces the hand-copied nav markup that used to live in
 * every HTML file. Edit nav items in src/data/site.ts.
 */
import { site, nav } from '../data/site';

const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/'
    ? path === '/' || path === '/index.html'
    : path === href || path === href.replace('.html', '');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name} home`}>
      <img
        src={site.logo}
        alt={`${site.name} - LPG autogas conversion Kenya`}
        width="160"
        height="52"
      />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={`tel:${site.phone}`}>
        <span class="visually-hidden">Call us on</span>
        {site.phoneDisplay}
      </a>
      <a class="btn btn--primary site-header__cta" href="/booking.html">Book Now</a>
    </div>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mobile-nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-nav__foot">
      <a class="btn btn--primary" href="/booking.html">Book Now</a>
      <a class="btn btn--ghost" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-h);
  }

  .site-header__brand {
    flex-shrink: 0;
  }

  .site-header__brand img {
    width: auto;
    height: 52px;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav__link {
    position: relative;
    display: block;
    padding-block: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ease);
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-nav__link:hover {
    color: var(--brand-hover);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .site-header__phone {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
    white-space: nowrap;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--ease), opacity var(--ease);
  }

  .site-header__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .site-header__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile nav ---------------------------------------------------- */

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: var(--space-4) var(--space-5) var(--space-6);
  }

  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
  }

  .mobile-nav__link {
    display: block;
    padding: var(--space-3) var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--ink);
    border-radius: var(--radius-sm);
  }

  .mobile-nav__link.is-active,
  .mobile-nav__link:hover {
    background: var(--brand-soft);
    color: var(--brand-hover);
  }

  .mobile-nav__foot {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (max-width: 1100px) {
    .site-nav,
    .site-header__phone {
      display: none;
    }

    .site-header__actions {
      margin-inline-start: auto;
    }

    .site-header__toggle {
      display: flex;
      margin-inline-start: auto;
    }
  }

  @media (max-width: 480px) {
    .site-header__cta {
      display: none;
    }
  }

  @media (min-width: 1101px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
