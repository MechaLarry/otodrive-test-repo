---
/**
 * Closing call-to-action band used at the bottom of content pages so every
 * page ends with the same conversion path.
 */
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Ready to cut your fuel costs?',
  text = 'Book a free consultation and find out how much you could save by switching to LPG autogas.',
  primaryLabel = 'Book a Service',
  primaryHref = '/booking.html',
  secondaryLabel = 'Get a Free Quote',
  secondaryHref = '/get-quote.html',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--ghost" href={secondaryHref}>{secondaryLabel}</a>
      <a class="cta-band__phone" href={`tel:${site.phone}`}>
        <i class="fa-solid fa-phone" aria-hidden="true"></i>
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-9);
    background: var(--brand-soft);
    border-top: 1px solid var(--line);
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
  }

  .cta-band h2 {
    max-width: 24ch;
  }

  .cta-band p {
    max-width: 52ch;
    margin-top: var(--space-3);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .cta-band__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--ink);
  }

  .cta-band__phone:hover {
    color: var(--brand-hover);
  }
</style>
